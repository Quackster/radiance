// r4d_gemm_w5a8_nt_m64.hip - r4d_gemm_w5a8_nt_m64: DENSE 5-bit-weight, fp8-activation skinny GEMM
// for M up to 64, gfx1201.  C[M,N] = A[M,K] @ dequant(Wq)[N,K]^T, A quantised per row to e4m3 and W
// stored as a dense signed 5-bit integer per K with one f16 scale per 32 elements along K.
//
// THIS IS THE DENSE-INT5 SIBLING OF r4d_gemm_mxfp6a8_nt_m64.  It shares the 32-lane fragment
// structure, the workgroup split-K, the LDS reduction, the per-32 f16 fold and the epilogue; the
// weight format is what differs, and it differs in exactly the two ways the plan (MXFP8-MXFP6-PLAN
// §8.1) says a dense 5-bit row must:
//
//   1. FIVE BITS A CODE, NOT SIX.  A signed integer code (RAD_I5, two's complement -16..15) is not
//      byte-aligned, so a lane's eight consecutive-k codes are 5 contiguous little-endian bytes
//      (rad_store_bits/rad_load_bits with width 5) rather than a whole number of bytes per code.
//      The fragment index is the mxfp6 one -- mxw_slot() in r4d_layout.cpp -- and because every
//      lane slot starts at an element index that is a multiple of 8, its 5-byte chunk is exactly
//      the eight codes it wants: 5*8 = 40 bits, no straddle.  The unpack is eight masked shifts.
//
//   2. THE PROMOTION IS INTEGER -> E4M3, NOT E2M3 -> E4M3.  A code c is sign-extended to
//      v = (c ^ 16) - 16 in [-16, 15], which is an exact E4M3 value (E4M3 holds every integer in
//      that range), so a 32-entry constexpr table gives the promoted byte and a host static_assert
//      re-derives both ends independently, entry for entry.  This is the DENSE grid: no nonlinear
//      codebook, because libquant's `w5nl` table is a property of the MoE expert path (`w5nl64a8h`)
//      and its codes are not an ABI integer dtype the generic libref can decode (see the report).
//
// THERE IS NO wref/dsh FOLD, as there is none for mxfp6/mxfp8: a 5-bit integer's magnitude is
// carried by the code and the group's f16 scale multiplies the block sum once:
//
//          acc += block_sum * s16[n][g]   per 32-column group
//
// THE WEIGHT IS PRE-PERMUTED INTO FRAGMENT ORDER, byte map and all, exactly as mxfp6's is; the
// only change is that the element index addresses a 5-bit stream rather than a 6-bit one.  A lane
// reads five bytes at ((t*ksteps + ks)*32 + l)*5 and a wave's request is 160 contiguous bytes.
//
// THE f16 SCALES ARE LEFT IN [K/32][N] ORDER -- a half-wave reads sixteen consecutive bytes.
//
// SPLIT-K IS IN THE WORKGROUP, as everywhere else in this library, and A is not staged in LDS in
// the m64 kernel: a lane's A fragment is eight consecutive bytes of one row.  Rows past M are
// CLAMPED rather than masked, which keeps the inner loop branch-free.  There is no staged prefill
// kernel for this row: the tiled entry reuses this launch with MB = 8, and the exit is a K that is
// a multiple of 32.
//
// TRAP FOR ANYONE MEASURING THIS KERNEL: a weight of tens of megabytes streamed in a loop is
// Infinity-Cache resident on this part, so a bandwidth figure taken that way can read above the
// DRAM roofline.  It ranks kernels reading the same bytes; it is not achieved DRAM bandwidth.
#include "r4d_gemm_args.h"
#include "r4d_common.h"

#include <hip/hip_bf16.h>
#include <hip/hip_fp16.h>
#include <cstdint>
#include <cstdio>
#include <stdexcept>

#define R4D_GEMM_W5A8_MAX_M 64
#define R4D_GEMM_W5A8_GROUP 32       // K per f16 scale group
#define WAVE32 32
#define R4D_W5A8_LANE_BYTES 5        // eight 5-bit codes = 40 bits = five bytes

typedef int      v2i    __attribute__((ext_vector_type(2)));

// The exact int5 -> E4M3 map.  Index is the signed 5-bit code read as a bit pattern (sign bit 4);
// the byte is the E4M3 value of v = (c ^ 16) - 16, an integer in [-16, 15].  Generated by the
// arithmetic below and pinned by the static_assert after it -- the table is checked, not trusted.
#define R4D_W5A8_PROM_ENTRIES                                                              \
  0x00u, 0x38u, 0x40u, 0x44u, 0x48u, 0x4Au, 0x4Cu, 0x4Eu,  /* v =  0.. 7 */               \
  0x50u, 0x51u, 0x52u, 0x53u, 0x54u, 0x55u, 0x56u, 0x57u,  /* v =  8..15 */               \
  0xD8u, 0xD7u, 0xD6u, 0xD5u, 0xD4u, 0xD3u, 0xD2u, 0xD1u,  /* v = -16..-9 */              \
  0xD0u, 0xCEu, 0xCCu, 0xCAu, 0xC8u, 0xC4u, 0xC0u, 0xB8u   /* v = -8..-1 */

constexpr unsigned char kInt5ToE4M3Const[32] = { R4D_W5A8_PROM_ENTRIES };
__device__ __constant__ unsigned char kInt5ToE4M3[32] = { R4D_W5A8_PROM_ENTRIES };

namespace r4d_w5a8_table {
// An independent decoder of both ends, so the check is of the format semantics and not of the
// encoder.  E4M3: bias 7; E==0 is M/8 * 2^-6, else 2^(E-7)*(1+M/8).
constexpr double dec_e4m3(unsigned b) {
  const unsigned e = (b >> 3) & 0xFu, m = b & 7u;
  double mag = 0.0;
  if (e == 0u) {
    mag = ((double)m / 8.0) * (1.0 / 64.0);
  } else {
    const int k = (int)e - 7;
    const double p = (k >= 0) ? (double)(1u << k) : (1.0 / (double)(1u << (-k)));
    mag = (1.0 + (double)m / 8.0) * p;
  }
  return (b & 0x80u) ? -mag : mag;
}
constexpr int dec_int5(unsigned c) { return (int)(c ^ 16u) - 16; }
constexpr bool ok() {
  for (int c = 0; c < 32; ++c)
    if (dec_e4m3(kInt5ToE4M3Const[c]) != (double)dec_int5((unsigned)c)) return false;
  return true;
}
}  // namespace r4d_w5a8_table
static_assert(r4d_w5a8_table::ok(),
              "r4d w5a8: kInt5ToE4M3 is not the exact int5->e4m3 map");

// Five bytes a lane = eight 5-bit codes, little-endian along the row.  Loaded explicitly as five
// bytes so the read never crosses the end of the N*K*5/8-byte stream.
__device__ __forceinline__ unsigned long long r4d_w5a8_load5(const unsigned char* __restrict__ p) {
  return (unsigned long long)p[0] | ((unsigned long long)p[1] << 8) |
         ((unsigned long long)p[2] << 16) | ((unsigned long long)p[3] << 24) |
         ((unsigned long long)p[4] << 32);
}

// The lane's 5-byte chunk in the fragment stream: slot = (ntile*ksteps + kstep)*32 + lane, five
// bytes a slot.
__device__ __forceinline__ const unsigned char* r4d_w5a8_slot(
    const unsigned char* __restrict__ W, int ntile, int ksteps, int kstep, int lane) {
  return W + (((size_t)ntile * ksteps + kstep) * WAVE32 + (size_t)lane) * R4D_W5A8_LANE_BYTES;
}

// Eight int5 codes (40 bits, packed in `w`) -> eight E4M3 bytes in k order, two dwords.
__device__ __forceinline__ v2i r4d_w5a8_unpack8(unsigned long long w) {
  const unsigned int v0 = (unsigned int)(w & 0x1Fu);
  const unsigned int v1 = (unsigned int)((w >> 5) & 0x1Fu);
  const unsigned int v2 = (unsigned int)((w >> 10) & 0x1Fu);
  const unsigned int v3 = (unsigned int)((w >> 15) & 0x1Fu);
  const unsigned int v4 = (unsigned int)((w >> 20) & 0x1Fu);
  const unsigned int v5 = (unsigned int)((w >> 25) & 0x1Fu);
  const unsigned int v6 = (unsigned int)((w >> 30) & 0x1Fu);
  const unsigned int v7 = (unsigned int)((w >> 35) & 0x1Fu);
  v2i out;
  out[0] = (int)((unsigned int)kInt5ToE4M3[v0] | ((unsigned int)kInt5ToE4M3[v1] << 8) |
                 ((unsigned int)kInt5ToE4M3[v2] << 16) | ((unsigned int)kInt5ToE4M3[v3] << 24));
  out[1] = (int)((unsigned int)kInt5ToE4M3[v4] | ((unsigned int)kInt5ToE4M3[v5] << 8) |
                 ((unsigned int)kInt5ToE4M3[v6] << 16) | ((unsigned int)kInt5ToE4M3[v7] << 24));
  return out;
}

template <int MT, int NPW>
__global__ void r4d_gemm_w5a8_nt_m64_kernel(
    const unsigned char* __restrict__ A, const float* __restrict__ As,
    const unsigned char* __restrict__ W, const __half* __restrict__ Ws,
    __hip_bfloat16* __restrict__ C, int M, int K, int N, int WV, int SK) {
  extern __shared__ float red[];
  const int tid = threadIdx.x, wave = tid / WAVE32, lane = tid % WAVE32;
  const int col_local = wave / SK, ksplit = wave % SK;
  const int nt0 = (blockIdx.x * WV + col_local) * NPW;
  const int mt0 = blockIdx.y * MT;
  const int Ks = K / SK, kbase = ksplit * Ks;
  const int nlane = lane & 15, mhalf = (lane >> 4) * 8;
  const int ksteps = K / 16;

  // acc is the running sum; tmp is the current 32-group's block sum, scaled in once per group.
  v8f acc[NPW][MT], tmp[NPW][MT];
#pragma unroll
  for (int j = 0; j < NPW; j++)
#pragma unroll
    for (int i = 0; i < MT; i++) { acc[j][i] = (v8f)(0.f); tmp[j][i] = (v8f)(0.f); }

  // Column tiles this wave owns, CLAMPED to the last real tile. grid.x rounds N/16 up to a multiple
  // of ncols = WV*NPW, so the tail block addresses tiles that do not exist; clamping the TILE (not
  // just the row) keeps the weight index inside the buffer. The epilogue still drops these columns.
  const int ntmax = N / 16 - 1;
  int wtile[NPW], wrow[NPW];
#pragma unroll
  for (int j = 0; j < NPW; j++) {
    const int t = nt0 + j;
    wtile[j] = t < ntmax ? t : ntmax;
    wrow[j] = wtile[j] * 16 + nlane;
  }

  // SOFTWARE-PIPELINED K LOOP: the next k-step's A and W loads are issued before the current
  // k-step's WMMA, so a K-tile's memory requests are in flight while the previous one computes.
  {
    const int kg0 = kbase;
    const int kstep0 = kg0 / 16;
    v2i af_cur[MT];
#pragma unroll
    for (int i = 0; i < MT; i++) {
      int r = (mt0 + i) * 16 + nlane;
      r = r < M - 1 ? r : M - 1;
      const unsigned int* pa = (const unsigned int*)(A + (size_t)r * K + kg0 + mhalf);
      af_cur[i][0] = (int)pa[0];
      af_cur[i][1] = (int)pa[1];
    }
    unsigned long long wv_cur[NPW];
#pragma unroll
    for (int j = 0; j < NPW; j++)
      wv_cur[j] = r4d_w5a8_load5(r4d_w5a8_slot(W, wtile[j], ksteps, kstep0, lane));

    for (int k = 0; k < Ks; k += 16) {
      // Issue the NEXT k-step's loads before this k-step's WMMA.
      v2i af_next[MT];
      unsigned long long wv_next[NPW];
      const int k1 = k + 16;
      if (k1 < Ks) {
        const int kg1 = kbase + k1;
        const int kstep1 = kg1 / 16;
#pragma unroll
        for (int i = 0; i < MT; i++) {
          int r = (mt0 + i) * 16 + nlane;
          r = r < M - 1 ? r : M - 1;
          const unsigned int* pa = (const unsigned int*)(A + (size_t)r * K + kg1 + mhalf);
          af_next[i][0] = (int)pa[0];
          af_next[i][1] = (int)pa[1];
        }
#pragma unroll
        for (int j = 0; j < NPW; j++)
          wv_next[j] = r4d_w5a8_load5(r4d_w5a8_slot(W, wtile[j], ksteps, kstep1, lane));
      }
      // Compute THIS k-step into the group accumulator.
#pragma unroll
      for (int j = 0; j < NPW; j++) {
        const v2i wf = r4d_w5a8_unpack8(wv_cur[j]);
#pragma unroll
        for (int i = 0; i < MT; i++)
          tmp[j][i] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(af_cur[i], wf, tmp[j][i]);
      }
      // Every second 16-k step closes a 32-group: scale its block sum by the group s16 and fold it
      // into acc, then reset the block accumulator. Ks is a multiple of 32, so a group always
      // closes inside the split (k & 16 is nonzero exactly on the second half of a group).
      if (k & 16) {
        const int blk = (kbase + k - 16) / R4D_GEMM_W5A8_GROUP;
#pragma unroll
        for (int j = 0; j < NPW; j++) {
          const float s = __half2float(Ws[(size_t)blk * N + wrow[j]]);
#pragma unroll
          for (int i = 0; i < MT; i++)
#pragma unroll
            for (int e = 0; e < 8; e++) {
              acc[j][i][e] += tmp[j][i][e] * s;
              tmp[j][i][e] = 0.f;
            }
        }
      }
      // Advance the double buffer -- only when a next step was actually loaded.
      if (k1 < Ks) {
#pragma unroll
        for (int i = 0; i < MT; i++) af_cur[i] = af_next[i];
#pragma unroll
        for (int j = 0; j < NPW; j++) wv_cur[j] = wv_next[j];
      }
    }
  }

  // Reduce the SK partial sums in LDS, one M tile at a time so the buffer stays WV*NPW*SK*256.
  // Each partial already carries its own groups' f16 scales, so this is a plain sum.
  const int ncols = WV * NPW;
#pragma unroll
  for (int i = 0; i < MT; i++) {
    __syncthreads();
#pragma unroll
    for (int j = 0; j < NPW; j++) {
      const int slot = ((col_local * NPW + j) * SK + ksplit) * 256;
#pragma unroll
      for (int e = 0; e < 8; e++) red[slot + lane * 8 + e] = acc[j][i][e];
    }
    __syncthreads();
    // One pass over the block's 256-element tiles; every thread takes a stride.
    for (int t = tid; t < ncols * 256; t += blockDim.x) {
      const int col = t >> 8, off = t & 255;
      const int n = (blockIdx.x * ncols + col) * 16 + ((off >> 3) & 15);
      const int m = (mt0 + i) * 16 + ((off >> 7) << 3) + (off & 7);
      if (n >= N || m >= M) continue;
      float v = 0.f;
      for (int s = 0; s < SK; s++) v += red[(col * SK + s) * 256 + off];
      C[(size_t)m * N + n] = (__hip_bfloat16)(v * As[m]);
    }
  }
}

extern "C" int r4d_gemm_w5a8_nt_m64_max_m(void) { return R4D_GEMM_W5A8_MAX_M; }
extern "C" int r4d_gemm_w5a8_nt_m64_group(void) { return R4D_GEMM_W5A8_GROUP; }

extern "C" void r4d_gemm_w5a8_nt_m64(long a, long ascale, long wq, long ws, long c,
                                     int M, int K, int N, int WV, int SK, int MB, int NPW,
                                     long stream) {
  /* M is unbounded here: the kernel tiles M over blockIdx.y (rows past M are clamped and dropped),
   * so the same launch serves the prefill band. The DECODE entry (r4d_rad_gemm_w5a8a8_m64) keeps
   * its own M <= R4D_GEMM_W5A8_MAX_M gate; the TILED entry does not. */
  if (M < 1)
    throw std::runtime_error("r4d gemm_w5a8_nt_m64: M must be >= 1");
  if (N % 16) throw std::runtime_error("r4d gemm_w5a8_nt_m64: N must be a multiple of 16");
  if (K % (SK * R4D_GEMM_W5A8_GROUP))
    throw std::runtime_error("r4d gemm_w5a8_nt_m64: K must be divisible by SK*32");
  if (WV * SK * WAVE32 > 1024)
    throw std::runtime_error("r4d gemm_w5a8_nt_m64: threads/block > 1024");
  if (MB < 1 || MB > 8) throw std::runtime_error("r4d gemm_w5a8_nt_m64: MB must be 1..8");
  if (NPW != 1 && NPW != 2 && NPW != 4 && NPW != 8)
    throw std::runtime_error("r4d gemm_w5a8_nt_m64: NPW must be 1, 2, 4 or 8");
  const int ntiles = N / 16, mtiles = (M + 15) / 16;
  const int ncols = WV * NPW;
  dim3 grid((ntiles + ncols - 1) / ncols, (mtiles + MB - 1) / MB);
  dim3 block(WV * SK * WAVE32);
  size_t smem = (size_t)ncols * SK * 256 * sizeof(float);
  if (smem > 64 * 1024)
    throw std::runtime_error("r4d gemm_w5a8_nt_m64: WV*NPW*SK too large");
  auto Ap = (const unsigned char*)a;
  auto Sp = (const float*)ascale;
  auto Wp = (const unsigned char*)wq;
  auto Zp = (const __half*)ws;
  auto Cp = (__hip_bfloat16*)c;
  hipStream_t st = (hipStream_t)stream;
#define LAUNCH(MTv, NPv) hipLaunchKernelGGL((r4d_gemm_w5a8_nt_m64_kernel<MTv, NPv>), grid, \
                                            block, smem, st, Ap, Sp, Wp, Zp, Cp, M, K, N, WV, SK)
#define LAUNCH_MB(NPv) switch (MB) { \
    case 1: LAUNCH(1, NPv); break; \
    case 2: LAUNCH(2, NPv); break; \
    case 3: LAUNCH(3, NPv); break; \
    case 4: LAUNCH(4, NPv); break; \
    case 8: LAUNCH(8, NPv); break; \
    default: throw std::runtime_error("r4d gemm_w5a8_nt_m64: MB unsupported"); }
  switch (NPW) {
    case 1: LAUNCH_MB(1); break;
    case 2: LAUNCH_MB(2); break;
    case 4: LAUNCH_MB(4); break;
    case 8: LAUNCH_MB(8); break;
    default: throw std::runtime_error("r4d gemm_w5a8_nt_m64: NPW unsupported");
  }
#undef LAUNCH_MB
#undef LAUNCH
}

// ============================================================== the plugin ABI entry points
//
// The operand reader and the split law are in r4d_gemm_args.h. Like mxfp6a8 there is NO b_ref:
// integer codes are scaled by the group factor and the fold is mxfp4's alone, so the shape
// hook and the layout hook both declare operand 6 (Q_BREF) absent for this dtype.
extern "C" int r4d_rad_gemm_w5a8a8_m64(const RadArgs* a, RadStream s) {
    GemmOps g;
    int rc = gemm_ops(a, &g, 1);
    if (rc != RAD_OK) return rc;
    if (g.N % 16) return R4D_NO(RAD_E_SHAPE);
    if (g.M > r4d_gemm_w5a8_nt_m64_max_m()) return R4D_NO(RAD_E_SHAPE);
    if (!g.ascale) return R4D_NO(RAD_E_INVAL);
    const int group = r4d_gemm_w5a8_nt_m64_group();
    Cfg c;
    rc = cfg_for(a, g.K, g.M, group, BR_FLAT, &c);
    if (rc != RAD_OK) return rc;
    R4D_TRY("gemm_w5a8_nt_m64",
        r4d_gemm_w5a8_nt_m64(r4d_addr(g.a), r4d_addr(g.ascale), r4d_addr(g.b),
                             r4d_addr(g.bscale), r4d_addr(g.y),
                             (int)g.M, (int)g.K, (int)g.N, c.wv, c.sk, c.mb, c.npw,
                             (long)(uintptr_t)s));
    return RAD_OK;
}

// The PREFILL band of the same kernel: the m64 launch with MB = 8, which serves any 32-aligned K.
// The numerics -- fragment-order weight read, exact int5->e4m3 promotion, per-32-group f16 scale
// folded into the block sum, per-row As[m] epilogue -- are the m64 kernel's, so this row and the
// decode row agree to the last bit at every M they share.
extern "C" int r4d_rad_gemm_w5a8a8_tiled(const RadArgs* a, RadStream s) {
    GemmOps g;
    int rc = gemm_ops(a, &g, 1);
    if (rc != RAD_OK) return rc;
    if (g.N % 16) return R4D_NO(RAD_E_SHAPE);
    if (!g.ascale) return R4D_NO(RAD_E_INVAL);
    int WV = 8, SK = 1, MB = 8, PNPW = 1;
    R4D_TRY("gemm_w5a8_nt_tiled",
        r4d_gemm_w5a8_nt_m64(r4d_addr(g.a), r4d_addr(g.ascale), r4d_addr(g.b),
                             r4d_addr(g.bscale), r4d_addr(g.y),
                             (int)g.M, (int)g.K, (int)g.N, WV, SK, MB, PNPW,
                             (long)(uintptr_t)s));
    return RAD_OK;
}
